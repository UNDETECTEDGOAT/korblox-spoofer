local player = game.Players.LocalPlayer

local function apply()
    local char = player.Character or player.CharacterAdded:Wait()

    local leg = char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("Right Leg")
    if not leg then return end

    -- R15 case (MeshPart)
    if leg:IsA("MeshPart") then
        -- force appearance override
        leg.MeshId = "rbxassetid://139607718"
        leg.TextureID = "rbxassetid://139607718"
    else
        -- R6 fallback
        for _, v in ipairs(leg:GetChildren()) do
            if v:IsA("SpecialMesh") then
                v:Destroy()
            end
        end

        local mesh = Instance.new("SpecialMesh")
        mesh.MeshId = "rbxassetid://139607718"
        mesh.TextureId = "rbxassetid://139607718"
        mesh.Parent = leg
    end
end

local function loopFix()
    while true do
        task.wait(1)
        pcall(apply)
    end
end

player.CharacterAdded:Connect(function()
    task.wait(1)
    apply()
end)

task.spawn(loopFix)
