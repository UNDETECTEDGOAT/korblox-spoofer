local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local function applyKorbloxLeg()
    local leg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightLowerLeg")
    if not leg then return end

    -- Remove existing mesh if any
    for _, v in ipairs(leg:GetChildren()) do
        if v:IsA("SpecialMesh") or v:IsA("Mesh") then
            v:Destroy()
        end
    end

    -- Apply Korblox mesh
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshId = "rbxassetid://139607718"
    mesh.TextureId = "rbxassetid://139607718"
    mesh.Parent = leg

    leg.Transparency = 0
end

applyKorbloxLeg()

player.CharacterAdded:Connect(function(char)
    character = char
    task.wait(1)
    applyKorbloxLeg()
end)
